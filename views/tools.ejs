<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tools • KenurkyBot</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;700&family=Great+Vibes&family=Rajdhani:wght@500;600;700&family=Rubik+Wet+Paint&family=Share+Tech+Mono&display=swap" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;700&family=Great+Vibes&family=Rajdhani:wght@500;600;700&family=Rubik+Wet+Paint&family=Share+Tech+Mono&display=swap"></noscript>
  <link rel="stylesheet" href="/css/cyber.css">
</head>
<body>
  <div class="bg">
    <div class="bg-grad"></div>
    <div class="scanline"></div>
  </div>

  <main class="container tools-page">
    <a href="/" class="tools-back">← Kembali ke Beranda</a>

    <h1 class="tools-logo">TOOLS</h1>
    <p class="tools-sub">Pilih alat yang kamu butuhkan</p>

    <div class="tool-card" id="toolCard">
      <div class="tool-head">
        <span class="tool-icon">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12.53.02C13.84 0 15.14.01 16.44 0c.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
        </span>
        <div class="tool-title-wrap">
          <strong class="tool-title">TikTok Downloader</strong>
          <small class="tool-sub">Download video TikTok tanpa watermark</small>
        </div>
        <span class="tool-badge">#1</span>
      </div>

      <div class="tt-form" id="ttForm">
        <input type="url" id="ttUrl" class="input" placeholder="Tempel link TikTok (vt.tiktok.com/...)" autocomplete="off">
        <button id="ttConfirm" class="tool-btn">Konfirmasi Link →</button>
      </div>

      <div id="ttLoading" class="tt-result hidden">
        <div class="spinner"></div>
        <p>⏳ Konfirmasi & memproses video...</p>
      </div>

      <div id="ttResult" class="hidden">
        <div class="tt-video-wrap">
          <video id="ttVideo" controls playsinline></video>
        </div>
        <p id="ttCaption" class="tt-caption"></p>
        <a id="ttDownload" class="tool-btn tt-download" download>⬇ Download Video</a>
        <button id="ttAgain" class="tool-btn-ghost">↻ Download video lain</button>
      </div>

      <div id="ttError" class="tt-result hidden"><p class="hasil-error"></p></div>
    </div>

    <div style="height:24px"></div>
    <a href="/" class="tools-back" style="text-align:center">© KenurkyBot • Cyber style</a>
  </main>

  <script>
    const form = document.getElementById('ttForm')
    const urlInput = document.getElementById('ttUrl')
    const confirmBtn = document.getElementById('ttConfirm')
    const loading = document.getElementById('ttLoading')
    const resultEl = document.getElementById('ttResult')
    const errEl = document.getElementById('ttError')
    const videoEl = document.getElementById('ttVideo')
    const capEl = document.getElementById('ttCaption')
    const dlBtn = document.getElementById('ttDownload')
    const againBtn = document.getElementById('ttAgain')

    function show(id) {
      confirmBtn.style.display = id === 'form' ? 'inline-flex' : 'none'
      form.style.display = id === 'form' ? 'flex' : 'none'
      loading.classList.toggle('hidden', id !== 'loading')
      resultEl.classList.toggle('hidden', id !== 'result')
      errEl.classList.toggle('hidden', id !== 'error')
    }

    confirmBtn.addEventListener('click', async () => {
      const url = urlInput.value.trim()
      if (!url) { urlInput.focus(); return }
      if (!/tiktok\.com|tiktok/i.test(url)) {
        errEl.querySelector('.hasil-error').textContent = '⚠️ Link bukan dari TikTok.'
        show('error')
        return
      }
      show('loading')
      try {
        const res = await fetch('/api/tiktok', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ url })
        })
        const d = await res.json()
        if (!d.ok) {
          errEl.querySelector('.hasil-error').textContent = '⚠️ ' + (d.error || 'Gagal memproses video.')
          show('error')
          return
        }
        videoEl.src = d.videoUrl
        videoEl.poster = d.thumbnail || ''
        capEl.textContent = d.caption || ''
        capEl.style.display = d.caption ? 'block' : 'none'
        dlBtn.href = '/api/tiktok/dl?url=' + encodeURIComponent(d.videoUrl)
        show('result')
      } catch (e) {
        errEl.querySelector('.hasil-error').textContent = '⚠️ Terjadi error. Coba lagi nanti.'
        show('error')
      }
    })

    againBtn.addEventListener('click', () => {
      videoEl.pause()
      videoEl.removeAttribute('src')
      videoEl.load()
      urlInput.value = ''
      urlInput.focus()
      show('form')
    })

    urlInput.addEventListener('keydown', e => { if (e.key === 'Enter') confirmBtn.click() })
  </script>
</body>
</html>