<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tools • KenurkyBot</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;700&family=Great+Vibes&family=Rajdhani:wght@500;600;700&family=Rubik+Wet+Paint&family=Share+Tech+Mono&display=swap" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;700&family=Great+Vibes&family=Rajdhani:wght@500;600;700&family=Rubik+Wet+Paint&family=Share+Tech+Mono&display=swap"></noscript>
  <link rel="stylesheet" href="/css/cyber.css">
</head>
<body>
  <div class="bg">
    <div class="bg-grad"></div>
    <div class="scanline"></div>
  </div>

  <main class="container tools-page">
    <a href="/" class="tools-back">← Kembali ke Beranda</a>

    <h1 class="tools-logo">TOOLS</h1>
    <p class="tools-sub">Pilih alat yang kamu butuhkan</p>

    <div class="tool-card" id="toolCard">
      <div class="tool-head">
        <span class="tool-icon">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12.53.02C13.84 0 15.14.01 16.44 0c.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
        </span>
        <div class="tool-title-wrap">
          <strong class="tool-title">TikTok Downloader</strong>
          <small class="tool-sub">Download video TikTok tanpa watermark</small>
        </div>
        <span class="tool-badge">#1</span>
      </div>

      <div class="tt-form" id="ttForm">
        <input type="url" id="ttUrl" class="input" placeholder="Tempel link TikTok (vt.tiktok.com/...)" autocomplete="off">
        <button id="ttConfirm" class="tool-btn">Konfirmasi Link →</button>
      </div>

      <div id="ttLoading" class="tt-result hidden">
        <div class="spinner"></div>
        <p>⏳ Konfirmasi & memproses video...</p>
      </div>

      <div id="ttResult" class="hidden">
        <div class="tt-video-wrap">
          <video id="ttVideo" controls playsinline></video>
        </div>
        <p id="ttCaption" class="tt-caption"></p>
        <a id="ttDownload" class="tool-btn tt-download" download>⬇ Download Video</a>
        <button id="ttAgain" class="tool-btn-ghost">↻ Download video lain</button>
      </div>

      <div id="ttDone" class="tt-done hidden">
        <div class="tt-done-mark">✓</div>
        <p class="tt-done-title">Video Anda sudah terdownload</p>
        <p class="tt-done-sub">File video sudah tersimpan di perangkat Anda.</p>
        <button id="ttDoneClose" class="tool-btn-ghost">Tutup</button>
      </div>

      <div id="ttError" class="tt-result hidden"><p class="hasil-error"></p></div>
    </div>

    <div class="tool-card" id="igCard">
      <div class="tool-head">
        <span class="tool-icon" style="color:var(--pink)">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.3" cy="6.7" r="1.2" fill="currentColor" stroke="none"/></svg>
        </span>
        <div class="tool-title-wrap">
          <strong class="tool-title">Instagram Downloader</strong>
          <small class="tool-sub">Download foto/video dari post &amp; reel Instagram</small>
        </div>
        <span class="tool-badge">#2</span>
      </div>

      <div class="tt-form" id="igForm">
        <input type="url" id="igUrl" class="input" placeholder="Tempel link Instagram (instagram.com/p/...)" autocomplete="off">
        <button id="igConfirm" class="tool-btn">Konfirmasi Link →</button>
      </div>

      <div id="igLoading" class="tt-result hidden">
        <div class="spinner"></div>
        <p>⏳ Konfirmasi & memproses media...</p>
      </div>

      <div id="igResult" class="hidden">
        <p id="igHint" class="tt-caption">Centang media yang ingin didownload:</p>
        <div class="ig-grid" id="igGrid"></div>
        <button id="igDownload" class="tool-btn tt-download">⬇ Download</button>
        <button id="igAgain" class="tool-btn-ghost">↻ Download post lain</button>
      </div>

      <div id="igDone" class="tt-done hidden">
        <div class="tt-done-mark">✓</div>
        <p class="tt-done-title">Media Anda sudah terdownload</p>
        <p class="tt-done-sub">File yang Anda centang sudah tersimpan di perangkat.</p>
        <button id="igDoneClose" class="tool-btn-ghost">Tutup</button>
      </div>

      <div id="igError" class="tt-result hidden"><p class="hasil-error"></p></div>
    </div>

    <div class="tool-card" id="rbgCard">
      <div class="tool-head">
        <span class="tool-icon" style="color:var(--neon)">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 3h10l6 6v12H3z"/><path d="M13 3v6h6"/><path d="M8 13l2.5 2.5L8 18M14 13l-2.5 2.5L14 18"/></svg>
        </span>
        <div class="tool-title-wrap">
          <strong class="tool-title">Hapus Background</strong>
          <small class="tool-sub">Hilangkan background foto jadi transparan</small>
        </div>
        <span class="tool-badge">#3</span>
      </div>

      <div class="rbg-form" id="rbgForm">
        <div class="rbg-preview" id="rbgPreview">
          <img id="rbgImg" style="display:none" alt="preview">
          <span class="rbg-placeholder" id="rbgPlaceholder">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 16l4-4 3 3 3-3 6 6"/><circle cx="9" cy="9" r="1.6"/><rect x="3" y="3" width="18" height="18" rx="4"/></svg>
            Klik untuk pilih foto
          </span>
        </div>
        <input type="file" id="rbgFile" accept="image/*" style="display:none">
        <p class="rbg-hint">Pilih foto dari galeri/HP kamu — sistemnya sama seperti ganti foto profil.</p>
        <button id="rbgProcess" class="tool-btn">✨ Hapus Background →</button>
      </div>

      <div id="rbgLoading" class="tt-result hidden">
        <div class="spinner"></div>
        <p>⏳ Menghilangkan background...</p>
      </div>

      <div id="rbgResult" class="hidden">
        <div class="rbg-result-wrap">
          <img id="rbgResultImg" alt="hasil">
        </div>
        <a id="rbgDownload" class="tool-btn tt-download" download>⬇ Download PNG</a>
        <button id="rbgAgain" class="tool-btn-ghost">↻ Proses foto lain</button>
      </div>

      <div id="rbgError" class="tt-result hidden"><p class="hasil-error"></p></div>
    </div>

    <div style="height:24px"></div>
    <a href="/" class="tools-back" style="text-align:center">© KenurkyBot • Cyber style</a>
  </main>

  <script>
    const form = document.getElementById('ttForm')
    const urlInput = document.getElementById('ttUrl')
    const confirmBtn = document.getElementById('ttConfirm')
    const loading = document.getElementById('ttLoading')
    const resultEl = document.getElementById('ttResult')
    const errEl = document.getElementById('ttError')
    const videoEl = document.getElementById('ttVideo')
    const capEl = document.getElementById('ttCaption')
    const dlBtn = document.getElementById('ttDownload')
    const againBtn = document.getElementById('ttAgain')
    const doneEl = document.getElementById('ttDone')
    const doneClose = document.getElementById('ttDoneClose')

    function show(id) {
      confirmBtn.style.display = id === 'form' ? 'inline-flex' : 'none'
      form.style.display = id === 'form' ? 'flex' : 'none'
      loading.classList.toggle('hidden', id !== 'loading')
      resultEl.classList.toggle('hidden', id !== 'result')
      errEl.classList.toggle('hidden', id !== 'error')
      doneEl.classList.toggle('hidden', id !== 'done')
    }

    function showDone() {
      show('done')
      setTimeout(() => {
        if (!doneEl.classList.contains('hidden')) {
          videoEl.pause()
          videoEl.removeAttribute('src')
          videoEl.load()
        }
      }, 500)
    }

    dlBtn.addEventListener('click', () => {
      // tampilkan notifikasi sukses setelah proses download dimulai
      setTimeout(showDone, 1200)
    })

    doneClose.addEventListener('click', () => {
      urlInput.value = ''
      urlInput.focus()
      show('form')
    })

    confirmBtn.addEventListener('click', async () => {
      const url = urlInput.value.trim()
      if (!url) { urlInput.focus(); return }
      if (!/tiktok\.com|tiktok/i.test(url)) {
        errEl.querySelector('.hasil-error').textContent = '⚠️ Link bukan dari TikTok.'
        show('error')
        return
      }
      show('loading')
      try {
        const res = await fetch('/api/tiktok', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ url })
        })
        const d = await res.json()
        if (!d.ok) {
          errEl.querySelector('.hasil-error').textContent = '⚠️ ' + (d.error || 'Gagal memproses video.')
          show('error')
          return
        }
        videoEl.src = d.videoUrl
        videoEl.poster = d.thumbnail || ''
        capEl.textContent = d.caption || ''
        capEl.style.display = d.caption ? 'block' : 'none'
        dlBtn.href = '/api/tiktok/dl?url=' + encodeURIComponent(d.videoUrl)
        show('result')
      } catch (e) {
        errEl.querySelector('.hasil-error').textContent = '⚠️ Terjadi error. Coba lagi nanti.'
        show('error')
      }
    })

    againBtn.addEventListener('click', () => {
      videoEl.pause()
      videoEl.removeAttribute('src')
      videoEl.load()
      urlInput.value = ''
      urlInput.focus()
      show('form')
    })

    urlInput.addEventListener('keydown', e => { if (e.key === 'Enter') confirmBtn.click() })

    // ===== Instagram =====
    const igForm = document.getElementById('igForm')
    const igUrl = document.getElementById('igUrl')
    const igConfirm = document.getElementById('igConfirm')
    const igLoading = document.getElementById('igLoading')
    const igResult = document.getElementById('igResult')
    const igGrid = document.getElementById('igGrid')
    const igHint = document.getElementById('igHint')
    const igDownloadBtn = document.getElementById('igDownload')
    const igAgainBtn = document.getElementById('igAgain')
    const igDoneEl = document.getElementById('igDone')
    const igDoneClose = document.getElementById('igDoneClose')
    const igErrorEl = document.getElementById('igError')
    const igErrorMsg = igErrorEl.querySelector('.hasil-error')

    let igItems = []

    function igShow(id) {
      igConfirm.style.display = id === 'form' ? 'inline-flex' : 'none'
      igForm.style.display = id === 'form' ? 'flex' : 'none'
      igLoading.classList.toggle('hidden', id !== 'loading')
      igResult.classList.toggle('hidden', id !== 'result')
      igErrorEl.classList.toggle('hidden', id !== 'error')
      igDoneEl.classList.toggle('hidden', id !== 'done')
    }

    function renderIgGrid() {
      igGrid.innerHTML = ''
      igItems.forEach((item, i) => {
        const box = document.createElement('div')
        box.className = 'ig-item'
        box.dataset.i = i
        box.innerHTML =
          '<span class="ig-badge">' + (i + 1) + '</span>' +
          '<span class="ig-check">✓</span>' +
          (item.isVideo
            ? '<video src="' + item.url + '" muted playsinline preload="metadata"></video>'
            : '<img src="' + item.url + '" alt="slide ' + (i + 1) + '" loading="lazy">')
        box.addEventListener('click', () => box.classList.toggle('checked'))
        igGrid.appendChild(box)
      })
      igHint.textContent = 'Centang media yang ingin didownload (' + igItems.length + ' slide ditemukan):'
    }

    igConfirm.addEventListener('click', async () => {
      const url = igUrl.value.trim()
      if (!url) { igUrl.focus(); return }
      if (!/instagram\.com/i.test(url)) {
        igErrorMsg.textContent = '⚠️ Link bukan dari Instagram.'
        igShow('error')
        return
      }
      igShow('loading')
      try {
        const res = await fetch('/api/ig?url=' + encodeURIComponent(url))
        const d = await res.json()
        if (!d.ok) {
          igErrorMsg.textContent = '⚠️ ' + (d.error || 'Gagal memproses media.')
          igShow('error')
          return
        }
        igItems = d.items
        renderIgGrid()
        igShow('result')
      } catch (e) {
        igErrorMsg.textContent = '⚠️ Terjadi error. Coba lagi nanti.'
        igShow('error')
      }
    })

    igDownloadBtn.addEventListener('click', () => {
      const selected = igItems.map((it, i) => ({ it, i }))
        .filter(({ i }) => document.querySelector('.ig-item[data-i="' + i + '"]')?.classList.contains('checked'))
      if (!selected.length) {
        igErrorMsg.textContent = '⚠️ Centang dulu media yang mau didownload.'
        igErrorEl.style.display = 'block'
        igResult.style.display = 'none'
        return
      }
      igErrorEl.style.display = 'none'
      selected.forEach(({ it }, idx) => {
        const ext = it.isVideo ? 'mp4' : 'jpg'
        const a = document.createElement('a')
        a.href = '/api/ig/dl?url=' + encodeURIComponent(it.url)
        a.download = 'instagram-' + (idx + 1) + '.' + ext
        setTimeout(() => { a.click() }, idx * 900)
      })
      setTimeout(() => {
        igDoneEl.classList.remove('hidden')
        igResult.classList.add('hidden')
      }, Math.max(1400, selected.length * 900 + 300))
    })

    igAgainBtn.addEventListener('click', () => {
      igUrl.value = ''
      igUrl.focus()
      igShow('form')
    })

    igDoneClose.addEventListener('click', () => {
      igUrl.value = ''
      igUrl.focus()
      igShow('form')
    })

    igUrl.addEventListener('keydown', e => { if (e.key === 'Enter') igConfirm.click() })

    // ===== Hapus Background =====
    const rbgForm = document.getElementById('rbgForm')
    const rbgPreview = document.getElementById('rbgPreview')
    const rbgImg = document.getElementById('rbgImg')
    const rbgPlaceholder = document.getElementById('rbgPlaceholder')
    const rbgFile = document.getElementById('rbgFile')
    const rbgProcess = document.getElementById('rbgProcess')
    const rbgLoading = document.getElementById('rbgLoading')
    const rbgResult = document.getElementById('rbgResult')
    const rbgResultImg = document.getElementById('rbgResultImg')
    const rbgDownload = document.getElementById('rbgDownload')
    const rbgAgain = document.getElementById('rbgAgain')
    const rbgErrorEl = document.getElementById('rbgError')
    const rbgErrorMsg = rbgErrorEl.querySelector('.hasil-error')

    let rbgDataUrl = null

    function rbgShow(id) {
      rbgForm.style.display = id === 'form' ? 'flex' : 'none'
      rbgLoading.classList.toggle('hidden', id !== 'loading')
      rbgResult.classList.toggle('hidden', id !== 'result')
      rbgErrorEl.classList.toggle('hidden', id !== 'error')
    }

    function rbgSetPreview(dataUrl) {
      rbgDataUrl = dataUrl
      if (dataUrl) {
        rbgImg.src = dataUrl
        rbgImg.style.display = 'block'
        rbgPlaceholder.style.display = 'none'
        rbgProcess.textContent = '✨ Hapus Background →'
        rbgProcess.disabled = false
      } else {
        rbgImg.removeAttribute('src')
        rbgImg.style.display = 'none'
        rbgPlaceholder.style.display = 'flex'
        rbgProcess.textContent = 'Pilih foto dulu'
        rbgProcess.disabled = true
      }
    }

    function rbgResize(file, maxSize, quality) {
      return new Promise((resolve, reject) => {
        const url = URL.createObjectURL(file)
        const img = new Image()
        img.onerror = () => { setTimeout(() => URL.revokeObjectURL(url), 1000); reject(new Error('decode')) }
        img.onload = () => {
          setTimeout(() => URL.revokeObjectURL(url), 1000)
          let w = img.width, h = img.height
          if (!w || !h) { reject(new Error('empty')); return }
          const scale = Math.min(1, maxSize / Math.max(w, h))
          w = Math.round(w * scale)
          h = Math.round(h * scale)
          const canvas = document.createElement('canvas')
          canvas.width = w
          canvas.height = h
          const ctx = canvas.getContext('2d')
          ctx.drawImage(img, 0, 0, w, h)
          resolve(canvas.toDataURL('image/png', quality || 0.9))
        }
        img.src = url
      })
    }

    rbgPreview.addEventListener('click', () => rbgFile.click())
    rbgFile.addEventListener('change', async (e) => {
      const file = e.target.files && e.target.files[0]
      if (!file) return
      if (file.size > 15 * 1024 * 1024) {
        rbgErrorMsg.textContent = '⚠️ File terlalu besar (maks 15MB).'
        rbgShow('error')
        return
      }
      try {
        const dataUrl = await rbgResize(file, 1280, 0.9)
        rbgSetPreview(dataUrl)
        rbgProcess.textContent = '✨ Hapus Background →'
      } catch (err) {
        const msg = err && err.message
        if (msg === 'decode' || msg === 'empty') {
          rbgErrorMsg.textContent = '⚠️ Foto tidak bisa dibaca browser (coba ubah ke JPG/PNG).'
          rbgShow('error')
        }
      }
    })

    rbgProcess.addEventListener('click', async () => {
      if (!rbgDataUrl) { rbgFile.click(); return }
      rbgShow('loading')
      try {
        const res = await fetch('/api/removebg', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ image: rbgDataUrl })
        })
        const d = await res.json()
        if (!d.ok) {
          rbgErrorMsg.textContent = '⚠️ ' + (d.error || 'Gagal hapus background.')
          rbgShow('error')
          return
        }
        rbgResultImg.src = d.resultUrl + '?t=' + Date.now()
        rbgDownload.href = '/api/removebg/dl?url=' + encodeURIComponent(d.resultUrl)
        rbgShow('result')
      } catch (e) {
        rbgErrorMsg.textContent = '⚠️ Terjadi error. Coba lagi nanti.'
        rbgShow('error')
      }
    })

    rbgAgain.addEventListener('click', () => {
      rbgFile.value = ''
      rbgSetPreview(null)
      rbgShow('form')
    })
  </script>
</body>
</html>